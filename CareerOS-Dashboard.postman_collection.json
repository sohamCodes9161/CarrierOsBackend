{
  "info": {
    "name": "CareerOS - Dashboard Module",
    "description": "Single read-only aggregation endpoint across every module - built so a frontend home screen doesn't need six separate requests. Run Auth -> Login first. Response sections gracefully null-out for modules you haven't used yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Dashboard",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Always includes interviews stats (never null, even for a new account)', () => {",
              "  pm.expect(json.data.dashboard.interviews).to.have.property('totalCompleted');",
              "});",
              "pm.test('Always includes roadmaps summary (never null)', () => {",
              "  pm.expect(json.data.dashboard.roadmaps).to.have.property('count');",
              "});",
              "console.log('Dashboard snapshot:', JSON.stringify(json.data.dashboard, null, 2));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dashboard"] },
        "description": "Try this early on a fresh account (resume/github/careerProfile/portfolio should all be null, interviews/roadmaps should be zeroed-out empty objects), then run it again after using a few other modules to see the sections populate."
      }
    },
    {
      "name": "Get Dashboard - No Auth (expect 401)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/v1/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dashboard"] }
      }
    }
  ]
}
