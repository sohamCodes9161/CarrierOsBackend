{
  "info": {
    "name": "CareerOS - GitHub Module",
    "description": "GitHub profile analysis. Run Auth -> Login first so accessToken is populated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Analyze GitHub Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Returns estimatedSkillLevel', () => pm.expect(['beginner','intermediate','advanced']).to.include(json.data.analysis.estimatedSkillLevel));",
              "pm.test('Returns languageBreakdown array', () => pm.expect(json.data.analysis.languageBreakdown).to.be.an('array'));",
              "pm.test('Returns commitCountLast90Days as a number', () => pm.expect(json.data.analysis.commitCountLast90Days).to.be.a('number'));",
              "pm.test('Returns repoHealth array', () => pm.expect(json.data.analysis.repoHealth).to.be.an('array'));",
              "if (json.data && json.data.analysis && json.data.analysis._id) { pm.environment.set('githubAnalysisId', json.data.analysis._id); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{testGithubUsername}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/github/analyze", "host": ["{{baseUrl}}"], "path": ["api", "v1", "github", "analyze"] }
      }
    },
    {
      "name": "Analyze - Invalid Username Format (expect 400)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"-invalid--name\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/github/analyze", "host": ["{{baseUrl}}"], "path": ["api", "v1", "github", "analyze"] }
      }
    },
    {
      "name": "Analyze - Nonexistent GitHub User (expect 404)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"this-user-should-not-exist-zzz-99999\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/github/analyze", "host": ["{{baseUrl}}"], "path": ["api", "v1", "github", "analyze"] }
      }
    },
    {
      "name": "Analyze - No Auth (expect 401)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"octocat\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/github/analyze", "host": ["{{baseUrl}}"], "path": ["api", "v1", "github", "analyze"] }
      }
    },
    {
      "name": "List My GitHub Analyses",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns an array', () => pm.expect(pm.response.json().data.analyses).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/github/analyses", "host": ["{{baseUrl}}"], "path": ["api", "v1", "github", "analyses"] }
      }
    },
    {
      "name": "Get Single GitHub Analysis",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/github/analyses/{{githubAnalysisId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "github", "analyses", "{{githubAnalysisId}}"] }
      }
    }
  ]
}
