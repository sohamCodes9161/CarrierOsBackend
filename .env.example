NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careeros?retryWrites=true&w=majority

# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Frontend origin for CORS + cookie settings
CLIENT_URL=http://localhost:5173

# Cloudinary (dashboard.cloudinary.com -> Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (console.groq.com/keys)
# Note: llama-3.3-70b-versatile was deprecated by Groq (shutdown Aug 16 2026).
# Defaulting to their recommended replacement, openai/gpt-oss-120b.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Groq voice (used by the AI Mock Interview voice layer - speech-to-text only)
# IMPORTANT: whisper-large-v3-turbo requires no special model acceptance step.
GROQ_STT_MODEL=whisper-large-v3-turbo

# Edge Neural TTS (msedge-tts) - free, no billing account, no per-request length limit.
# Female: en-US-AriaNeural, en-US-AvaNeural. Male: en-US-GuyNeural, en-US-AndrewNeural.
EDGE_TTS_VOICE=en-US-AriaNeural

# GitHub personal access token (optional but recommended - raises rate limit 60/hr -> 5000/hr)
# Create one at github.com/settings/tokens with no scopes needed (public read access is enough)
GITHUB_TOKEN=
