{
  "info": {
    "name": "CareerOS - Resume Module",
    "description": "Resume upload + AI ATS analysis. Run the Auth collection's Login request first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Analyze Resume (no job description)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Returns atsScore between 0-100', () => {",
              "  const score = json.data.analysis.atsScore;",
              "  pm.expect(score).to.be.at.least(0);",
              "  pm.expect(score).to.be.at.most(100);",
              "});",
              "pm.test('jobMatchScore is -1 when no JD given', () => pm.expect(json.data.analysis.jobMatchScore).to.eql(-1));",
              "pm.test('Cloudinary URL is present', () => pm.expect(json.data.resume.cloudinaryUrl).to.include('cloudinary'));",
              "if (json.data && json.data.analysis && json.data.analysis._id) { pm.environment.set('analysisId', json.data.analysis._id); }",
              "if (json.data && json.data.resume && json.data.resume._id) { pm.environment.set('resumeId', json.data.resume._id); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "resume", "type": "file", "src": [] },
            { "key": "jobDescription", "value": "", "type": "text" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/api/v1/resumes/analyze", "host": ["{{baseUrl}}"], "path": ["api", "v1", "resumes", "analyze"] },
        "description": "Attach tests/fixtures/sample-resume.pdf (included in the project zip) to the 'resume' form field before sending."
      }
    },
    {
      "name": "Analyze Resume (with job description)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('jobMatchScore is between 0-100 when JD is given', () => {",
              "  const score = json.data.analysis.jobMatchScore;",
              "  pm.expect(score).to.be.at.least(0);",
              "  pm.expect(score).to.be.at.most(100);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "resume", "type": "file", "src": [] },
            { "key": "jobDescription", "value": "We are looking for a Backend Engineer with strong Node.js, Express, and MongoDB experience. AWS and Docker knowledge is a plus.", "type": "text" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/api/v1/resumes/analyze", "host": ["{{baseUrl}}"], "path": ["api", "v1", "resumes", "analyze"] }
      }
    },
    {
      "name": "Analyze Resume - No File (expect 400)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": { "mode": "formdata", "formdata": [{ "key": "jobDescription", "value": "", "type": "text" }] },
        "url": { "raw": "{{baseUrl}}/api/v1/resumes/analyze", "host": ["{{baseUrl}}"], "path": ["api", "v1", "resumes", "analyze"] }
      }
    },
    {
      "name": "Analyze Resume - No Auth (expect 401)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "body": { "mode": "formdata", "formdata": [{ "key": "resume", "type": "file", "src": [] }] },
        "url": { "raw": "{{baseUrl}}/api/v1/resumes/analyze", "host": ["{{baseUrl}}"], "path": ["api", "v1", "resumes", "analyze"] }
      }
    },
    {
      "name": "List My Analyses",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns an array', () => pm.expect(pm.response.json().data.analyses).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/resumes/analyses", "host": ["{{baseUrl}}"], "path": ["api", "v1", "resumes", "analyses"] }
      }
    },
    {
      "name": "Get Single Analysis",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/resumes/analyses/{{analysisId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "resumes", "analyses", "{{analysisId}}"] }
      }
    },
    {
      "name": "Delete Resume",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }
      ],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/resumes/{{resumeId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "resumes", "{{resumeId}}"] }
      }
    }
  ]
}
