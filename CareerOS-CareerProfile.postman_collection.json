{
  "info": {
    "name": "CareerOS - Career Profile Module",
    "description": "Unified career profile aggregating resume, GitHub, and interview data. Run Auth -> Login first. For a meaningful result, run at least one of the Resume/GitHub/Interview collections first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Generate Career Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns a narrative', () => pm.expect(json.data.profile.narrative).to.be.a('string').and.not.empty);",
              "pm.test('Returns a valid readiness level', () => pm.expect(['early-stage','developing','job-ready','strong']).to.include(json.data.profile.overallReadinessLevel));",
              "pm.test('Returns topPriorityFocus array', () => pm.expect(json.data.profile.topPriorityFocus).to.be.an('array'));",
              "pm.test('Returns skills array', () => pm.expect(json.data.profile.skills).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/career-profile/generate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "career-profile", "generate"] },
        "description": "Regenerates the profile from your latest resume analysis, latest GitHub analysis, and all completed interviews. Safe to run repeatedly - it upserts in place, one profile per user."
      }
    },
    {
      "name": "Generate - No Auth (expect 401)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/api/v1/career-profile/generate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "career-profile", "generate"] }
      }
    },
    {
      "name": "Get Career Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns the profile', () => pm.expect(pm.response.json().data.profile).to.be.an('object'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/v1/career-profile", "host": ["{{baseUrl}}"], "path": ["api", "v1", "career-profile"] }
      }
    }
  ]
}
